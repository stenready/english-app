NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://english:english@localhost:5432/english_app

# File storage (S3 API). Local: SeaweedFS from docker-compose; production: AWS S3, Cloudflare R2…
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=app-files
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
# Bucket URLs: SeaweedFS needs http://host/bucket/key instead of http://bucket.host/key
S3_FORCE_PATH_STYLE=true
# Public base for file links (a CDN in production)
S3_PUBLIC_URL=http://localhost:8333/app-files
