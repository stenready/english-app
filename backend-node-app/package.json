{
  "name": "backend-node-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#app": {
      "development": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "#config/*": {
      "development": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#constants/*": {
      "development": "./src/constants/*.ts",
      "default": "./dist/constants/*.js"
    },
    "#controllers/*": {
      "development": "./src/controllers/*/index.ts",
      "default": "./dist/controllers/*/index.js"
    },
    "#errors/*": {
      "development": "./src/errors/*.ts",
      "default": "./dist/errors/*.js"
    },
    "#middlewares/*": {
      "development": "./src/middlewares/*.ts",
      "default": "./dist/middlewares/*.js"
    },
    "#repositories/*": {
      "development": "./src/repositories/*/index.ts",
      "default": "./dist/repositories/*/index.js"
    },
    "#routes/*": {
      "development": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    },
    "#services/*": {
      "development": "./src/services/*/index.ts",
      "default": "./dist/services/*/index.js"
    },
    "#types/*": {
      "development": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0"
  }
}
