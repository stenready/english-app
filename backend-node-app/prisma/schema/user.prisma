// Postgres enum: any other value is rejected by the database itself
enum UserStatus {
  ACTIVE
  // Can't sign in; the account and its data stay
  BLOCKED
  // Signed up, not confirmed yet (e.g. email)
  PENDING

  @@map("user_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  // argon2 hash; the password itself is never stored
  passwordHash String     @map("password_hash")
  // S3 key of the image (user/avatars/<uuid>.webp); the API adds the full URL. null: initials
  avatarKey    String?    @map("avatar_key")
  // Users added from the admin are active right away; sign-up will set PENDING
  status       UserStatus @default(ACTIVE)
  // Optional for now: existing users have no role yet
  roleId       String?    @map("role_id") @db.Uuid
  role         Role?      @relation(fields: [roleId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@index([roleId])
  @@map("users")
}
